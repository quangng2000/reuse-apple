#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x=128) in;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.v[2])return;
    uint remainder=i, source=0, stride=1;
    bool inside=true;
    for(int axis=5;axis>=0;--axis) {
        int coordinate=int(remainder%pc.v[8+axis])-int(pc.v[20+axis]);
        remainder/=pc.v[8+axis];
        inside=inside && coordinate>=0 && coordinate<int(pc.v[14+axis]);
        source+=uint(max(coordinate,0))*stride;
        stride*=pc.v[14+axis];
    }
    arena.data[pc.v[1]+i]=inside?arena.data[pc.v[3]+source]:uintBitsToFloat(pc.v[6]);
}
