#version 450
#extension GL_GOOGLE_include_directive : require
#include "common_fast.glsl"
layout(local_size_x=128) in;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.v[2])return;
    float condition=arena.data[pc.v[3]+address6Fast(i,14)];
    arena.data[pc.v[1]+i]=condition!=0.0
        ?arena.data[pc.v[4]+address6Fast(i,20)]
        :arena.data[pc.v[5]+address6Fast(i,26)];
}
