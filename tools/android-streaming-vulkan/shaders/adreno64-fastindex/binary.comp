#version 450
#extension GL_GOOGLE_include_directive : require
#include "common_fast.glsl"
layout(local_size_x=128) in;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.v[2])return;
    float a=arena.data[pc.v[3]+address6Fast(i,14)];
    float b=arena.data[pc.v[4]+address6Fast(i,20)];
    precise float y=0.0;
    switch(pc.v[6]) {
        case 1:y=a+b;break;
        case 2:y=a*b;break;
        case 3:y=a/b;break;
        case 4:y=a<0.0?a*b:a;break;
        case 5:y=a<b?1.0:0.0;break;
        case 6:y=a>b?1.0:0.0;break;
        case 7:y=a==b?1.0:0.0;break;
        case 8:y=a-b;break;
        case 9:y=pow(a,b);break;
        case 10:y=max(a,b);break;
        case 11:y=min(a,b);break;
    }
    arena.data[pc.v[1]+i]=y;
}
